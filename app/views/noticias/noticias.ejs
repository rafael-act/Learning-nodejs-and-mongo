<!DOCTYPE html>
<html lang="pt-br">
  <head>
    <meta charset="utf-8" />
    <title>Notícias</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">

  </head>
  <body>
    <div class="container">
    <h1>Notícias view</h1>
    <table  class="table table-striped-columns">
      <tr><th>ID</th>
        <th>Título</th>
        <th>Resumo</th>
        <th>Data Noticia</th>
        <th>autor</th>
        <th>Notícia</th>
        <th>Data Criacao</th>
      </tr>
	  <% for (var i = noticias.length - 1; i >= 0; i--) { %>
	  <tr>
		<th scope="row"><%= noticias[i].id_noticia %></td>
		<td><%= noticias[i].titulo %></td>
		<td><%= noticias[i].resumo %></td>
		<td><%= noticias[i].data_noticia %></td>
		<td><%= noticias[i].autor %></td>
		<td><%= noticias[i].noticia %></td>
		<td><%= noticias[i].data_criacao %></td>
	  </tr>
	  <% } %>
    </table>
</div>
       <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>

  </body>
</html>
