<!DOCTYPE html>
<html lang="pt-br">
  <head>
    <meta charset="utf-8" />
    <title>Portal de notícias</title>
  </head>
  <body>
    <h1>Notícia</h1>
    <table border="1">
      <tr>
        <th>ID</th>
        <th>Título</th>
        <th>Notícia</th>
        <th>Data</th>
      </tr>
     	  <% for (var i = 0; i < noticia.length; i++) { %>
	  <tr>
		<td><%= noticia[i].id_noticia %></td>
		<td><%= noticia[i].titulo %></td>
		<td><%= noticia[i].noticia %></td>
		<td><%= noticia[i].data_criacao %></td>
	  </tr>
	  <% } %>
      
    </table>
  </body>
</html>
