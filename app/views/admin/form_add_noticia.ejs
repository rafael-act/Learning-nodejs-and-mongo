<!DOCTYPE html>
<html lang="pt-br">
  <head>
    <meta charset="utf-8" />
    <title>Formulário de cadastro de Notícia</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
      crossorigin="anonymous"
    />
  </head>
  <body>
    <div class="container">
    <h1>Adicionar notícia</h1>
    <br />
      <% if(validacao.length>0){ %>
		
    <div class="alert alert-danger" role="alert">
		<ul>
		  <% for(var i=0; i<validacao.length; i++) { %>
			<li><%= validacao[i].msg %></li>
		  <% }; %>
		</ul>
    </div>
	  <% } %>
    <form action="/noticias/salvar" method="post">
      <label for="titulo">Título:</label>
      <input
        type="text"
        id="titulo"
        name="titulo"
        placeholder="Titulo da noticia"
        value="<%= noticia.titulo%>"
      />
      <br />
      <label for="resumo">Resumo:</label>
      <input
        type="text"
        id="resumo"
        name="resumo"
        placeholder="Resumo da noticia"
        value="<%= noticia.resumo%>"
      />
      <br />
      <label for="autor">Autor:</label>
      <input
        type="text"
        id="autor"
        name="autor"
        placeholder="Autor da noticia"
        value="<%= noticia.autor%>"
      />
      <br />
      <label for="data_noticia">Data dos Fatos:</label>
      <input
        type="date"
        id="data_noticia"
        name="data_noticia"
        placeholder="Data dos fatos"
        value="<%= noticia.data_noticia%>"
      />
      <br />
      <label for="noticia">Notícia:</label>
      <textarea id="noticia" name="noticia" rows="5" cols="30"><%= noticia.noticia%></textarea>
      <br />
      <input type="submit" value="Enviar" />
    </form>
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
      crossorigin="anonymous"
    ></script>
	</div>
  </body>
</html>
